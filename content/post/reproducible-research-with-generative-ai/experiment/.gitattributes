# The checksums of the data files are part of the analysis, so their line
# endings must not be converted on checkout. SHA256SUMS lists the checksums of
# the specification and the data files, and is kept as written too.
*.csv -text
spec.json -text
SHA256SUMS -text
# The kept outputs of the scripts are written with '\n' line endings, and they
# stay the same bytes on every system.
outputs/** -text
# The records of the runs (prompts, replies, tool logs and scripts), the
# second round's lockfile and the text records of the sessions keep the bytes
# they were written with, so that every checkout gives the same files.
prompts/** -text
runs/** -text
rerun/runs/** -text
rerun/library.lock -text
*.txt -text
